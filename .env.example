# Server Configuration
PORT=3035
HOST=127.0.0.1

# JWT Configuration
JWT_SECRET=pressto-secrets-prod
JWT_EXPIRES_IN=7h

# PostgreSQL Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=

# Email Configuration (Optional - for OTP/notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Razorpay ("PGLink") payment gateway — use Razorpay's test-mode keys
# until production keys are issued; no code change needed to switch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# QR configurations
QR_SCAN_REQUIRED=true
# How many days after delivery a customer may still claim a free reprocess.
# Defaults to 7 when unset or invalid.
REPROCESS_WINDOW_DAYS=7

# How far (km) a customer's address may be from a store for that store to
# be auto-assigned as their preferred store, or for a self-service pickup
# request to be serviceable. Defaults to 15 when unset or invalid.
STORE_ASSIGNMENT_RADIUS_KM=15

# Firebase Cloud Messaging — rider push notifications (pickup/delivery/
# transfer assignment, reassignment, cancellation). Path to the service
# account JSON downloaded from Firebase Console (Project Settings >
# Service Accounts > Generate new private key); see
# firebase-service-account.json.placeholder for where to put it. Until
# that file exists, NotificationService logs one warning at startup and
# every send becomes a no-op instead of throwing.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Google Geocoding API — resolves a customer address's lat/lng on the fly
# when it has none saved (older addresses, or ones saved without the
# frontend's location picker), so pickup-request store assignment and
# preferredStoreId auto-assignment still have coordinates to work with.
# Needs the Geocoding API enabled on the key; a browser-restricted Maps
# JavaScript API key (e.g. the admin-panel's) may not work here since
# this is a server-to-server call. Until this is set, GeocodingService
# logs one warning and every geocode attempt is a no-op.
GOOGLE_GEOCODING_API_KEY=

# WhatsApp Business API (Karix/Tata RCM gateway, rcmapi.instaalerts.zone)
# — template notifications, starting with the PGLink payment-link message
# ('linkopt1'). TATA_WABA_SOURCE_NUMBER is the WhatsApp number registered
# against the API key. TATA_WABA_API_URL only needs setting if it ever
# differs from Karix's default. Until TATA_WABA_API_KEY/
# TATA_WABA_SOURCE_NUMBER are set, WhatsAppService logs one warning and
# every send is a no-op instead of throwing.
TATA_WABA_API_KEY=
TATA_WABA_SOURCE_NUMBER=
TATA_WABA_API_URL=
TATA_WABA_WEBHOOK_DN_ID=1001
