# Server Configuration
PORT=3035
HOST=127.0.0.1

# JWT Configuration
JWT_SECRET=pressto-secrets-prod
JWT_EXPIRES_IN=7h

# PostgreSQL Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=

# Email Configuration (Optional - for OTP/notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Razorpay ("PGLink") payment gateway — use Razorpay's test-mode keys
# until production keys are issued; no code change needed to switch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# QR configurations
QR_SCAN_REQUIRED=true
# How many days after delivery a customer may still claim a free reprocess.
# Defaults to 7 when unset or invalid.
REPROCESS_WINDOW_DAYS=7

# How far (km) a customer's address may be from a store for that store to
# be auto-assigned as their preferred store, or for a self-service pickup
# request to be serviceable. Defaults to 15 when unset or invalid.
STORE_ASSIGNMENT_RADIUS_KM=15

# Firebase Cloud Messaging — rider push notifications (pickup/delivery/
# transfer assignment, reassignment, cancellation). Path to the service
# account JSON downloaded from Firebase Console (Project Settings >
# Service Accounts > Generate new private key); see
# firebase-service-account.json.placeholder for where to put it. Until
# that file exists, NotificationService logs one warning at startup and
# every send becomes a no-op instead of throwing.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
