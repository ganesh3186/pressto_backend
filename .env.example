# Server Configuration
PORT=3035
HOST=127.0.0.1

# JWT Configuration
JWT_SECRET=pressto-secrets-prod
JWT_EXPIRES_IN=7h

# PostgreSQL Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=

# Email Configuration (Optional - for OTP/notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Razorpay ("PGLink") payment gateway — use Razorpay's test-mode keys
# until production keys are issued; no code change needed to switch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# QR configurations
QR_SCAN_REQUIRED=true
# How many days after delivery a customer may still claim a free reprocess.
# Defaults to 60 when unset or invalid.
REPROCESS_WINDOW_DAYS=60

# How far (km) a customer's address may be from a store for that store to
# be auto-assigned as their preferred store, or for a self-service pickup
# request to be serviceable. Defaults to 15 when unset or invalid.
STORE_ASSIGNMENT_RADIUS_KM=15

# Firebase Cloud Messaging — rider push notifications (pickup/delivery/
# transfer assignment, reassignment, cancellation). Path to the service
# account JSON downloaded from Firebase Console (Project Settings >
# Service Accounts > Generate new private key); see
# firebase-service-account.json.placeholder for where to put it. Until
# that file exists, NotificationService logs one warning at startup and
# every send becomes a no-op instead of throwing.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Google Geocoding API — resolves a customer address's lat/lng on the fly
# when it has none saved (older addresses, or ones saved without the
# frontend's location picker), so pickup-request store assignment and
# preferredStoreId auto-assignment still have coordinates to work with.
# Needs the Geocoding API enabled on the key; a browser-restricted Maps
# JavaScript API key (e.g. the admin-panel's) may not work here since
# this is a server-to-server call. Until this is set, GeocodingService
# logs one warning and every geocode attempt is a no-op.
GOOGLE_GEOCODING_API_KEY=

# Customer notifications through Tata Omni. Never commit the real token.
WHATSAPP_ENABLED=false
# Only the unpaid delivery-assignment template/link creation. Unset defaults to true.
# The paid rider-details notification and manually shared PG links are unaffected.
WHATSAPP_DELIVERY_PAYMENT_LINK_ENABLED=true
WHATSAPP_API_URL=https://wb.omni.tatatelebusiness.com/whatsapp-cloud/messages
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en
# V2 ticket-created and payment-received templates require document headers.
# Enable only with provider-approved templates and publicly reachable PDFs.
WHATSAPP_ATTACHMENTS_ENABLED=false
# Support number supplied to the rider-delivery-complete template.
WHATSAPP_SUPPORT_PHONE=1800229199
# Backend base (include any reverse-proxy path prefix); HTTP and HTTPS are both supported.
# Customers cannot open localhost links on their phones. Falls back to API_ENDPOINT.
PUBLIC_DOCUMENT_BASE_URL=http://localhost:3040
# Generate a unique random secret of at least 32 bytes; keep stable across deployments/instances.
ORDER_SUMMARY_URL_SIGNING_SECRET=
# Customer ticket-summary and invoice links expire after 7 days by default.
ORDER_SUMMARY_LINK_TTL_SECONDS=604800
